---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Paleta from '../components/Paleta.astro';
import { SITE } from '../config/site';
import { url } from '../lib/rutas';

interface Props { titulo?: string; descripcion?: string; color?: string, compacto?: boolean; }
const { titulo, descripcion = SITE.descripcion, color = '#7C5CFF', compacto = false } = Astro.props;
const completo = titulo ? `${titulo} - ${SITE.nombre}` : SITE.titulo;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0B0D12" />
        <link rel = "canonical" href={canonica} />
        <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
        <meta property="og:title" content={completo} />
        <meta property="og:description" content={descripcion} />
        <meta property="og:type" content="website" />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..500,0,0&display=block" rel="stylesheet" />
    </head>
    <body style={`--c:${color}`}>
        <Header compacto={compacto} />
        <slot />
        <Footer />
        <Paleta />
    </body>
</html>